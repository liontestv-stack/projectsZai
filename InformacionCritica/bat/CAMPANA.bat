@echo off
title CAMPANA - ARCHIVO UNICO (el script viaja dentro, verificado por SHA256)
cd /d "%~dp0"
setlocal
set "PYEXE=python"
where py >nul 2>nul && set "PYEXE=py"
set "PYDEST=%~dp0campana-10-pasos.py"
set "SHAESPERADO=2C6CD2460A123A61F94ADDCC3D0F085AB8BBA7CF5C710998E2FABB1735A77A31"
echo ==================================================
echo  CAMPANA - MODO AUTO (archivo unico)
echo  doble click = trabaja SOLO los pasos 1..6 en orden
echo  (mide, promueve, juzga, descarga, verifica y mide N1;
echo   puede tardar ~2-4 h; todo queda en campana-INFORME.md)
echo  solo mirar: CAMPANA.bat estado   paso manual: CAMPANA.bat pN
echo ==================================================

rem 1) extraer y decodificar el payload que viaja dentro de este bat
set "SKIP="
for /f "usebackq delims=:" %%L in (`findstr /N /B /C:"###PY64###" "%~f0"`) do if not defined SKIP set "SKIP=%%L"
if not defined SKIP (
  echo [FATAL] payload no encontrado: CAMPANA.bat danado. No se ejecuta nada.
  pause
  exit /b 1
)
set "B64=%TEMP%\campana-payload.b64"
set "PYTMP=%TEMP%\campana-10-pasos.py"
more +%SKIP% "%~f0" > "%B64%"
certutil -decode "%B64%" "%PYTMP%" >nul 2>nul
if errorlevel 1 (
  echo [FATAL] payload ilegible: CAMPANA.bat danado. No se ejecuta nada.
  pause
  exit /b 1
)

rem 2) verificar SHA256 ANTES de ejecutar nada (seguridad anti-malware)
set "SHAOK="
for /f "skip=1 delims=" %%H in ('certutil -hashfile "%PYTMP%" SHA256 2^>nul') do if not defined SHAOK set "SHAOK=%%H"
if /I not "%SHAOK%"=="%SHAESPERADO%" (
  echo [FATAL] SHA256 no coincide: el archivo se altero. PARADA LIMPIA.
  echo   esperado: %SHAESPERADO%
  echo   obtenido: %SHAOK%
  pause
  exit /b 1
)

rem 3) instalar la copia verificada y arrancar (sin argumentos = MODO AUTO)
copy /Y "%PYTMP%" "%PYDEST%" >nul
%PYEXE% "%PYDEST%" %*
echo.
pause
exit /b 0
